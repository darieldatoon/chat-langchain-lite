# Copied to agent/.env by `mise run setup`. Never commit agent/.env.
# mda dev reads only this file. `mise run demo:install` copies the Gateway key into each deployment's secrets.

# Your LangSmith personal access token, for local tracing and the demo scripts. Deployments get their own.
LANGSMITH_API_KEY=

# Your LangChain Inc Gateway key (LC_GATEWAY_KEY). `mise run setup` fills it on MDM-managed Macs.
LANGSMITH_GATEWAY_API_KEY=

# Origins allowed to call the agent from a browser. This replaces the deployment's default
# allow-list, so keep https://smith.langchain.com or the LangSmith UI can't reach the agent.
# `mise run demo:install` sets the deployments' list, adding https://<owner>.github.io.
MDA_CORS_ORIGINS=http://localhost:5173,https://smith.langchain.com

# "Sign in with LangSmith": the OAuth app's client id (lsc_…), from an org admin. Not a secret.
# `mise run demo:install` passes it to the web app and to both deployments, with the org id read
# from your key. Blank means the app offers only personal access tokens.
OAUTH_CLIENT_ID=
# Only for trying OAuth against `mda dev`; deployments get it from install.
ALLOWED_ORGANIZATION_ID=
